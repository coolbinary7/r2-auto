{
  "manifest_version": 2,
  "name": "Auto R2",
  "version": "0.5.0",
  "description": "Saisit une sortie dans R2 à partir du mail de mise en ligne : release, piste, auteurs, mix/master, cover, rattachement.",
  "permissions": [
    "storage",
    "tabs",
    "*://r2.umusic.net/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://r2.umusic.net/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "sidebar_action": {
    "default_title": "Auto R2",
    "default_panel": "sidebar.html",
    "default_icon": "icons/48.png",
    "open_at_install": true
  },
  "browser_action": {
    "default_title": "Auto R2",
    "default_icon": {
      "48": "icons/48.png"
    }
  },
  "icons": {
    "48": "icons/48.png",
    "96": "icons/96.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "r2-auto@bigced.reviews",
      "strict_min_version": "91.0"
    }
  }
}