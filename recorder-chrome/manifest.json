{
  "manifest_version": 3,
  "name": "R2 Recorder (Chrome)",
  "version": "0.2.0",
  "description": "Enregistre les clics, saisies, glisser-déposer et envois de fichiers dans l'onglet choisi (RWS, CWS, AIT…) pour préparer l'automatisation.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "rec.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "R2 Recorder",
    "default_icon": {
      "48": "icon48.png"
    }
  },
  "icons": {
    "48": "icon48.png"
  }
}