{
  "manifest_version": 2,
  "name": "R2 Recorder",
  "version": "0.2.0",
  "description": "Enregistre les clics, saisies, glisser-déposer et envois de fichiers dans l'onglet choisi (R2, RWS, CWS, AIT…) pour préparer l'automatisation.",
  "permissions": [
    "storage",
    "downloads",
    "tabs",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "bg.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "rec.js"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "match_about_blank": true
    }
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "R2 Recorder",
    "default_icon": {
      "48": "icon48.png"
    }
  },
  "icons": {
    "48": "icon48.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "r2-recorder@bigced.reviews",
      "strict_min_version": "91.0"
    }
  }
}